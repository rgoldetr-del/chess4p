[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.3"

[libraries]
windows.debug.x86_64 = "res://bin/libchess_analyzer.dll"
windows.release.x86_64 = "res://bin/libchess_analyzer.dll"
linux.debug.x86_64 = "res://bin/libchess_analyzer.so"
linux.release.x86_64 = "res://bin/libchess_analyzer.so"